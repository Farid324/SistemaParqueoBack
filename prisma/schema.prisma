// Prisma Schema para SistemaParqueoBack

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// TENANT: dueños de parqueo y su suscripción
// ==========================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  taxId     String?
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users        User[]
  parkingLots  ParkingLot[]
  subscription Subscription?

  @@map("organizations")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  priceCents     Int
  currency       String   @default("USD")
  maxParkingLots Int
  maxSpotsPerLot Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String             @unique
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodEnd       DateTime
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("subscriptions")
}

// ==========================================
// USUARIOS (staff de organización + clientes finales)
// ==========================================

enum Role {
  SUPER_ADMIN
  OWNER
  OPERATOR
  CUSTOMER
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  name            String
  password        String
  phone           String?
  role            Role          @default(CUSTOMER)
  isActive        Boolean       @default(true)
  emailVerifiedAt DateTime?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  refreshTokens RefreshToken[]
  vehicles      Vehicle[]
  reservations  Reservation[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// PARQUEOS (lado dueño)
// ==========================================

enum ParkingLotStatus {
  ACTIVE
  INACTIVE
}

model ParkingLot {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  address           String
  latitude          Float
  longitude         Float
  pricePerHourCents Int
  currency          String           @default("USD")
  openingTime       String? // ej. "06:00"
  closingTime       String? // ej. "22:00"
  status            ParkingLotStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  zones ParkingZone[]
  spots ParkingSpot[]

  @@index([latitude, longitude])
  @@map("parking_lots")
}

model ParkingZone {
  id           String     @id @default(uuid())
  parkingLotId String
  parkingLot   ParkingLot @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  spots ParkingSpot[]

  @@unique([parkingLotId, name])
  @@map("parking_zones")
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
}

enum ParkingSpotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model ParkingSpot {
  id           String            @id @default(uuid())
  parkingLotId String
  parkingLot   ParkingLot        @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         ParkingZone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  spotNumber   String
  vehicleType  VehicleType       @default(CAR)
  status       ParkingSpotStatus @default(AVAILABLE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  reservations Reservation[]

  @@unique([parkingLotId, spotNumber])
  @@map("parking_spots")
}

// ==========================================
// USUARIO FINAL: vehículos y reservas
// ==========================================

model Vehicle {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plate       String
  vehicleType VehicleType @default(CAR)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  reservations Reservation[]

  @@unique([userId, plate])
  @@map("vehicles")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELED
  NO_SHOW
}

model Reservation {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingSpotId String
  parkingSpot   ParkingSpot       @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status        ReservationStatus @default(PENDING)
  startTime     DateTime
  endTime       DateTime
  amountCents   Int
  currency      String            @default("USD")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([parkingSpotId, startTime, endTime])
  @@map("reservations")
}
